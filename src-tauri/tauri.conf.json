{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Warcraft 3 Gym Overlay",
  "version": "0.1.0",
  "identifier": "gym.warcraft3.overlay",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "picker",
        "title": "Warcraft 3 Gym — Build picker",
        "url": "picker.html",
        "width": 960,
        "height": 640,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "visible": true
      },
      {
        "label": "overlay",
        "title": "Build order",
        "url": "overlay.html",
        "width": 380,
        "height": 520,
        "minWidth": 280,
        "minHeight": 240,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "visible": false,
        "shadow": false,
        "focusable": false,
        "focus": false,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
